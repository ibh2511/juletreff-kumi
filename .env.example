# Kopier til .env og fyll inn før `npm run deploy`.
# Dette er offentlig betalingsinfo, ikke hemmeligheter. Legg ALDRI Vipps API-nøkler her:
# alt med VITE_ i navnet havner i koden som sendes til nettleseren.

# Vipps-nummeret deltakerne betaler til
VITE_VIPPS_NUMBER=

# Valgfritt: betalingslenke eller qr.vipps.no-lenke som åpner Vipps direkte
VITE_VIPPS_PAYMENT_URL=

# Valgfritt: QR-kode fra Vipps-portalen, lagt i public/images/ (f.eks. images/vipps-qr.png)
VITE_VIPPS_QR_IMAGE=
