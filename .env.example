# Kopier til .env og fyll inn før `npm run deploy`.
# Dette er offentlig info, ikke hemmeligheter. Legg ALDRI Vipps API-nøkler eller passord her:
# alt med VITE_ i navnet havner i koden som sendes til nettleseren.

# Adressen til Apps Script-backenden (backend/Code.gs), slutter på /exec
VITE_API_URL=

# Vipps-nummeret eller mobilnummeret deltakerne betaler til uten Vipps-avtale.
# Det som er lagret i adminsiden, vinner.
VITE_VIPPS_NUMBER=45454642

# Kontakt-e-post for spørsmål, venteliste og legeerklæring
VITE_KONTAKT_EPOST=

# Visningsverdier før backend svarer (backend bestemmer det som gjelder)
VITE_PRIS=600
VITE_DATO_TEKST=Fredag 18. desember kl. 18.30
VITE_FRIST_TEKST=onsdag 16. desember
